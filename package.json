  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "astro": "7.4.0",
    "sharp": "^0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0"
  }
}
