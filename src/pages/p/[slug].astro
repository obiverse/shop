---
import { Picture, getImage } from "astro:assets";
import { render } from "astro:content";
import Shell from "../../layouts/Shell.astro";
import Icon from "../../components/Icon.astro";
import Card from "../../components/Card.astro";
import { products, houseOf, houses, href, money, stockLabel, iso, offer, endsLabel, type Product } from "../../lib/shop";

export async function getStaticPaths() {
  return (await products()).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const h = await houseOf(p);
const d = p.data;
const cur = h.data.currency;
const { Content } = await render(p);
const rent = d.mode === "rent";
const o = offer(p, h);
const priceText = money(o?.now ?? d.price, cur) + (rent ? " / day" : "") + (o ? ` (was ${money(o.was, cur)})` : "");
const og = await getImage({ src: d.images[0], width: 1200, height: 630, fit: "cover", format: "jpeg" });
const hs = await houses();
const more = [
  ...(await products((x) => x.data.house.id === h.id && x.id !== p.id)),
  ...(await products((x) => x.data.house.id !== h.id && x.data.featured)),
].slice(0, 8);
const today = new Date().toISOString().slice(0, 10);
const booked = (d.rent?.booked ?? []).filter((r) => iso(r.to) >= today);
const fmt = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const units = d.rent?.units;
const unit = d.rent?.unit ?? "item";
const max = rent ? (units ?? 1) : 20;
const perks = rent
  ? [["📅", "We hold your dates", "Confirmed with you on WhatsApp before you pay"], ["🚚", "Delivered & collected", "Ugep and surroundings, agreed with you"], ["🧼", "Clean & well maintained", "Wiped down after every event"]]
  : h.id === "sandals"
    ? [["✋", "Handmade in Nigeria", "Real leather, strong stitched soles"], ["🚚", "Nationwide delivery", "Cost agreed with you on WhatsApp"], ["📏", "Not sure of your size?", "Ask us on WhatsApp before you order"]]
    : [["✅", "Authentic & sealed", "Delivered in the original box"], ["🚚", "Nationwide delivery", "Cost agreed with you on WhatsApp"], ["💬", "Ask before you buy", "We'll describe the scent honestly"]];
---
<Shell title={d.title} description={`${priceText} · ${d.summary}`} image={og.src} bare>
  <Fragment slot="head">
    <meta property="og:type" content="product" />
    <meta property="product:price:amount" content={String(o?.now ?? d.price)} />
    <meta property="product:price:currency" content={cur} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Product", name: d.title, description: d.summary,
      image: new URL(og.src, Astro.site).href, brand: h.data.name,
      offers: { "@type": "Offer", price: o?.now ?? d.price, priceCurrency: cur, ...(o?.ends && { priceValidUntil: o.ends }), availability: `https://schema.org/${d.stock === "out" ? "OutOfStock" : d.stock === "made_to_order" ? "PreOrder" : "InStock"}` },
    })} />
    {d.model && <script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.4.0/dist/model-viewer.min.js" />}
  </Fragment>

  <div class="float-top">
    <a class="icon-btn glass" href={href()} data-back aria-label="Back"><Icon name="back" /></a>
    <span class="sp ttl">{d.title}</span>
    <button class="icon-btn glass" data-share={new URL(href(`p/${p.id}/`), Astro.site).href} data-title={`${d.title} — ${priceText}`} aria-label="Share"><Icon name="share" /></button>
    <button class="icon-btn glass heart-btn" data-save={p.id} aria-pressed="false" aria-label="Save"><Icon name="heart" /></button>
    <a class="icon-btn glass" href={href("cart/")} aria-label="Cart" data-cart-target><Icon name="cart" /><span class="count" data-cart-count hidden>0</span></a>
  </div>

  <article class="pdp" data-id={p.id} data-mode={d.mode} data-unit={unit} data-cur={cur} data-house={h.id} data-wa={h.data.whatsapp.replace(/\D/g, "")}>
    <div class="gallery" style={d.tint && `--tint:${d.tint}`}>
      <div class="slides" id="slides">
        {d.images.map((img, i) => (
          <Picture src={img} alt={`${d.title}, photo ${i + 1}`} widths={[480, 720, 1080, 1440]} sizes="(min-width: 900px) 640px, 100vw" formats={["avif", "webp"]} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} data-fly-src={i === 0 ? "" : undefined} />
        ))}
        {d.model && <div><model-viewer src={href(d.model)} alt={`${d.title} in 3D`} camera-controls auto-rotate ar touch-action="pan-y" shadow-intensity="1" /></div>}
      </div>
      {d.images.length > 1 && <div class="dots" id="dots">{[...d.images, ...(d.model ? [1] : [])].map((_, i) => <i class:list={{ on: i === 0 }} />)}</div>}
    </div>

    <div class="info">
      <a class="chip-house" href={href(`h/${h.id}/`)} style={`--h:${h.data.accent}`}><i></i>{h.data.name}</a>
      <h1>{d.title}</h1>
      <div class="price" data-ends={o?.ends} data-regular={o && money(d.price, cur)}>
        <span class:list={["now", { hot: o }]}>{money(o?.now ?? d.price, cur)}</span>{rent && <small>per {unit} per day</small>}
        {o && <s data-offer-only>{money(o.was, cur)}</s>}
        {o && <span class="off" data-offer-only>−{o.pct}%</span>}
      </div>
      {o && (
        <div class="offer" data-offer-only data-ends={o.ends}>
          <span>🔥 <b>{o.label}</b> · you save {money(o.was - o.now, cur)}{o.ends && <> · ends {endsLabel(o.ends)}</>}</span>
          {o.ends && <span class="timer" data-countdown={o.ends}>…</span>}
        </div>
      )}
      {rent ? (
        <div class="stock" data-s="in">{units ? `${units} ${unit}s available` : "Available"}{d.rent?.deposit ? ` · deposit ${money(d.rent.deposit, cur)} each` : ""} · min {d.rent?.min_days ?? 1} day{(d.rent?.min_days ?? 1) > 1 ? "s" : ""}</div>
      ) : (
        <div class="stock" data-s={d.stock}>{stockLabel[d.stock]}{d.lead_days && ` · ready in about ${d.lead_days} days`}</div>
      )}
      <p class="summary">{d.summary}</p>

      <form id="add">
        {d.options.map((o) => (
          <fieldset>
            <legend>{o.name}</legend>
            <div class="opts">
              {o.values.map((v, i) => (
                <label><input type="radio" name={o.name} value={v} required checked={o.values.length === 1 && i === 0} /><span>{v}</span></label>
              ))}
            </div>
          </fieldset>
        ))}

        {rent && (
          <fieldset>
            <legend>Your dates</legend>
            <div class="dates">
              <label class="field">From<input type="date" name="from" min={today} required /></label>
              <label class="field">To<input type="date" name="to" min={today} required /></label>
            </div>
            <div class="avail" id="avail" aria-live="polite"></div>
            <div class="estimate" id="estimate" aria-live="polite"></div>
            {booked.length > 0 && <p class="booked">Already booked: {booked.map((r) => `${fmt(r.from)}–${fmt(r.to)}${r.qty && units ? ` (${r.qty} ${unit}s)` : ""}`).join(" · ")}</p>}
          </fieldset>
        )}

        <div class="actionbar">
          <div class="qty" aria-label="Quantity">
            <button type="button" data-q={units ? "-10" : "-1"} aria-label="Fewer">−</button>
            <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max={max} value={units ? Math.min(50, units) : 1} aria-label={`How many${rent ? ` ${unit}s` : ""}`} />
            <button type="button" data-q={units ? "10" : "1"} aria-label="More">+</button>
          </div>
          <button class="btn brand grow" id="addbtn" disabled={d.stock === "out"}>{d.stock === "out" ? "Sold out" : rent ? "Add booking" : "Add to cart"}</button>
          <button class="btn wa sq" type="button" id="buynow" disabled={d.stock === "out"} aria-label={`Order this now on WhatsApp`} title="Order this now on WhatsApp"><Icon name="wa" /></button>
        </div>
      </form>

      <div class="perks">{perks.map(([e, t, s]) => <div><span>{e}</span><p><b>{t}</b>{s}</p></div>)}</div>
      <div class="prose"><Content /></div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="sec">
      <div class="sechead"><h2>You may also like</h2></div>
      <div class="rail">{more.map((x) => <Card p={x} house={hs.find((hh) => hh.id === x.data.house.id)!} />)}</div>
    </section>
  )}
</Shell>

<script>
  import { cart, profile, viewed, orders, type Item } from "../../scripts/store";
  import { load, money } from "../../scripts/ledger";
  import { toast, buzz, fly, confetti } from "../../scripts/app";

  const art = document.querySelector<HTMLElement>(".pdp")!;
  const { id, unit, cur, house, wa } = art.dataset as Record<string, string>;
  const rent = art.dataset.mode === "rent";
  const form = document.getElementById("add") as HTMLFormElement;
  const qtyEl = document.getElementById("qty") as HTMLInputElement;
  const btn = document.getElementById("addbtn") as HTMLButtonElement;
  const avail = document.getElementById("avail");
  const estimate = document.getElementById("estimate");
  viewed.push(id);
  const qtyNow = () => Math.max(1, Math.min(Number(qtyEl.max), Math.round(Number(qtyEl.value) || 1)));

  // Back goes back when they came from the shop; otherwise home.
  document.querySelector<HTMLAnchorElement>("[data-back]")!.addEventListener("click", (e) => {
    if (history.length > 1 && document.referrer.includes(location.host)) { e.preventDefault(); history.back(); }
  });

  // The floating controls get a solid bar (and the title) once the photo scrolls away.
  const top = document.querySelector(".float-top")!;
  const gallery = document.querySelector<HTMLElement>(".gallery")!;
  const solid = () => top.classList.toggle("solid", scrollY > gallery.offsetHeight - 90);
  addEventListener("scroll", solid, { passive: true });
  solid();

  // Gallery dots follow the swipe.
  const slides = document.getElementById("slides")!;
  const dots = [...document.querySelectorAll("#dots i")];
  slides.addEventListener("scroll", () => {
    const i = Math.round(slides.scrollLeft / slides.clientWidth);
    dots.forEach((d, j) => d.classList.toggle("on", i === j));
  }, { passive: true });

  form.querySelectorAll<HTMLButtonElement>("[data-q]").forEach((b) => b.addEventListener("click", () => {
    qtyEl.value = String(Math.max(1, Math.min(Number(qtyEl.max), qtyNow() + Number(b.dataset.q))));
    buzz();
    if (rent) check();
  }));
  qtyEl.addEventListener("change", () => { qtyEl.value = String(qtyNow()); });

  // Rentals: the ledger checks minimum days and stock on every day as things change.
  async function check() {
    if (!rent || !avail) return true;
    const f = new FormData(form);
    const from = String(f.get("from") || ""), to = String(f.get("to") || "");
    if (!from || !to) { avail.textContent = ""; if (estimate) estimate.textContent = ""; return false; }
    const { ledger } = await load();
    const qty = qtyNow();
    const r = ledger.dates(id, from, to, qty) as { ok: boolean; days: number; free: number; error?: string };
    avail.dataset.ok = String(r.ok);
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;
    avail.textContent = r.ok ? `✓ Available · ${plural(r.days, "day")}${r.free > 1 ? ` · ${r.free} ${unit}s free` : ""}` : r.error ?? "";
    if (estimate) {
      const q = ledger.quote([{ id, qty, opt: "", from, to }]) as { lines: { total: number; deposit: number }[] };
      const l = q.lines[0];
      estimate.textContent = r.ok ? `${plural(qty, unit)} × ${plural(r.days, "day")} = ${money(l.total, cur)}${l.deposit ? ` + ${money(l.deposit, cur)} refundable deposit` : ""}` : "";
    }
    return r.ok;
  }
  if (rent) { form.addEventListener("change", check); load(); }

  // The item as chosen, or null after pointing at what's missing.
  async function chosen(): Promise<Item | null> {
    const missing = [...form.querySelectorAll("fieldset")].find((fs) => fs.querySelector("input[type=radio]") && !fs.querySelector("input:checked"));
    if (missing) {
      missing.scrollIntoView({ behavior: "smooth", block: "center" });
      const opts = missing.querySelector(".opts")!;
      opts.classList.remove("shake"); void (opts as HTMLElement).offsetWidth; opts.classList.add("shake");
      toast(`Choose a ${missing.querySelector("legend")!.textContent!.toLowerCase()}`);
      return null;
    }
    if (!form.reportValidity()) return null;
    if (!(await check())) { toast("Choose dates that are free"); return null; }
    const f = new FormData(form);
    const opt = [...form.querySelectorAll("fieldset legend")].map((l) => l.textContent!).filter((n) => f.has(n)).map((n) => `${n} ${f.get(n)}`).join(", ");
    return { id, qty: qtyNow(), opt, from: String(f.get("from") || ""), to: String(f.get("to") || "") };
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const item = await chosen();
    if (!item) return;
    cart.add(item);
    fly(document.querySelector<HTMLImageElement>("#slides img"));
    btn.textContent = "Added ✓";
    toast("Added to cart", true);
    setTimeout(() => (btn.textContent = rent ? "Add booking" : "Add to cart"), 1600);
  });

  // Buy now: this one item straight to the house on WhatsApp.
  document.getElementById("buynow")!.addEventListener("click", async () => {
    const item = await chosen();
    if (!item) return;
    const { ledger, catalog } = await load();
    const me = profile.get();
    const note = [me.area && `Deliver to: ${me.area}`, me.note].filter(Boolean).join(" · ");
    const text = ledger.message([item], house, new URL(`${import.meta.env.BASE_URL}order/`, location.origin).href, me.name, note);
    open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
    const t = (ledger.quote([item]) as { houses: { code: string; total: number; currency: string }[] }).houses[0];
    orders.add({ code: t.code, house, name: catalog.houses.find((h) => h.id === house)!.name, at: Date.now(), total: money(t.total, t.currency), items: [item], wa });
    confetti();
    toast(`Order ${t.code} sent 🎉`);
  });
</script>
