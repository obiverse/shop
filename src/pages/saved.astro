---
import Shell from "../layouts/Shell.astro";
import Card from "../components/Card.astro";
import { houses, products, href } from "../lib/shop";

const hs = await houses();
const byId = Object.fromEntries(hs.map((h) => [h.id, h]));
const ps = await products();
---
<Shell title="Saved" tab="saved">
  <div class="page-title"><h1>Saved</h1><span class="muted" id="n"></span></div>
  <div class="grid sec" id="grid" style="margin-top:16px">{ps.map((p) => <Card p={p} house={byId[p.data.house.id]} />)}</div>
  <div class="empty" id="empty" hidden>
    <div class="art">💛</div>
    <h2>Nothing saved yet</h2>
    <p>Tap the heart on anything you love and it waits for you here, even offline.</p>
    <a class="btn brand" href={href()}>Discover the shop</a>
  </div>
</Shell>

<script>
  import { saved } from "../scripts/store";
  function show() {
    const s = saved.all();
    let n = 0;
    document.querySelectorAll<HTMLElement>("#grid .card").forEach((c) => {
      const on = s.includes(c.querySelector<HTMLElement>("[data-save]")!.dataset.save!);
      c.hidden = !on;
      if (on) n++;
    });
    document.getElementById("empty")!.hidden = n > 0;
    document.getElementById("grid")!.hidden = n === 0;
    document.getElementById("n")!.textContent = n ? `${n} item${n > 1 ? "s" : ""}` : "";
  }
  addEventListener("shop:change", show);
  show();
</script>
