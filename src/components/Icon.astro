  cart: "M5 7h14l-1.3 10.4A2 2 0 0 1 15.7 19H8.3a2 2 0 0 1-2-1.6L5 7Zm3.5 0V6a3.5 3.5 0 0 1 7 0v1M9 11v1.5m6-1.5v1.5",
  heart: "M12 20s-7-4.4-9.2-9A5 5 0 0 1 12 6a5 5 0 0 1 9.2 5c-2.2 4.6-9.2 9-9.2 9Z",
  share: "M12 3v12m0-12-4 4m4-4 4 4M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6",
  back: "M15 5l-7 7 7 7",
  arrow: "M5 12h14m-6-6 6 6-6 6",
  chev: "M9 6l6 6-6 6",
  close: "M6 6l12 12M18 6 6 18",
  search: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 4 4",
  plus: "M12 5v14M5 12h14",
  wa: "M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm-3.3 5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.6l-.6.7c-.1.2-.2.3 0 .6.5.9 1.2 1.6 2 2.2.4.3.8.5 1.2.7.2.1.4.1.5-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.4.4 0 .5-.2 1.2-.6 1.6-.6.5-1.3.7-2 .6-1.6-.3-3-1-4.2-2.2-1.2-1.1-2.1-2.4-2.5-4-.2-.8 0-1.6.6-2.2.2-.3.5-.5.7-.5Z",
};
type Props = { name: keyof typeof paths; class?: string };
const { name, class: cls } = Astro.props;
const solid = name === "wa";
---
<svg class={cls} viewBox="0 0 24 24" fill={solid ? "currentColor" : "none"} stroke={solid ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
</svg>
